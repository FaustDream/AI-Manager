# 运行期数据：账号 token（DPAPI）、积分台账、备份、日志、账号档案
# 体积 400MB+ 且含敏感信息，绝不入库
data/

# 历史版本 zip 归档（40MB），只做本地留存
legacy/

# 项目内虚拟环境（226MB），由 setup.vbs / uv sync 重建
.venv/

# 打包用：独立的构建环境与中间产物，只在本机/CI 生成
.venv-build/
build/
dist/

# 2.0 的发布产物（exe / 免安装 zip / NSIS 安装包）由 CI 构建，不入库
dist-v2/
packaging/nsis/*.exe

# v2 前端：依赖由 npm 安装（package-lock.json 入库，CI 用 npm ci）
node_modules/

# 本机 cargo 镜像配置（tuna 的 dl 在本机连不上，换 rsproxy；CI 走默认源）
src-tauri/.cargo/

# v1 数据归档：由「归档 v1 文件」生成，内含账号库密文与会话索引，属用户数据
data-v1-archive/

# Python
__pycache__/
*.py[cod]
*.pyo

# Rust：构建产物可达数 GB，绝不入库（Cargo.lock 属 binary crate，应入库）
src-tauri/target/
# tauri-build 每次编译都会重写，属于生成物
src-tauri/gen/

# 界面截图：图中会带出账号昵称、邮箱、本地路径（C:\Users\<用户名>），绝不入库
shots/

# 项目文档（README / CHANGELOG / AGENTS 等）：只做本地留存，不入库
docs/
AGENTS.md

# 本地临时文件
*.log
*.tmp
*.old
.DS_Store
Thumbs.db

# 编辑器 / 工具私有数据
.idea/
.codebuddy/
.workbuddy/
.workbuddy-ai/
