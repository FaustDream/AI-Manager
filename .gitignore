# 敏感数据（红线 2/6）：账号密文、DPAPI 凭据、运行期台账，绝不入库
data/
data-v1-archive/

# 可再生构建产物
node_modules/
dist/
release/
src-tauri/target/
# 隔离测试构建目录（CARGO_TARGET_DIR，开发版占用 target/debug 时跑测试用）
src-tauri/target-test/
src-tauri/gen/
__pycache__/
*.py[cod]

# 本机私有配置（src-tauri/.cargo 是本机 cargo 镜像配置，CI 走默认源）
src-tauri/.cargo/
.idea/
.codebuddy/
.workbuddy/
.workbuddy-ai/
.trae/
.trae-html-share-packages/

# 本地留存，不入库（docs/shots 截图带账号昵称等信息；tools/ 开发脚本与素材随本机走）
docs/
AGENTS.md
tools/
.trae/skills/

# 打包脚本必须入库（发布要可复现），只忽略产物
packaging/nsis/*.exe

# 临时与系统垃圾
*.log
*.tmp
*.old
.DS_Store
Thumbs.db
wb_tool逆向/
workbuddy-manager逆向/
.screenshots/
启动开发版.vbs

# 截图用的隔离沙盒（AIMANAGER_DATA_DIR + 假 USERPROFILE，演示数据不入库）
.sandbox/