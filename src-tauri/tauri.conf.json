{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Manager",
  "version": "1.5.0",
  "identifier": "com.faustdream.aimanager",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"]
  }
}
