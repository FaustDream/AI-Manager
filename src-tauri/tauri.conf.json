{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Manager",
  "version": "2.0.15",
  "identifier": "com.faustdream.aimanager",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5273",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AI Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png"],
    "publisher": "FaustDream",
    "copyright": "© 2026 FaustDream",
    "shortDescription": "签到 / 会话 / 技能分发一体化桌面工作台",
    "longDescription": "把五家 AI 编程平台（Qoder、WorkBuddy、ZCode、Trae、CodeBuddy）的每日签到与本地会话库管理合并到一个界面：账号与登录态切换、积分台账、会话浏览与删除、技能与 MCP 分发、日志与维护。",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
