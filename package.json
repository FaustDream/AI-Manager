{
  "name": "ai-manager-ui",
  "private": true,
  "version": "2.0.17",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "test:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/wb-heavy-run.ps1 -Task cargo-test -Wait",
    "test:rust:lib": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/wb-heavy-run.ps1 -Task cargo-test-lib -Wait",
    "check:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/wb-heavy-run.ps1 -Task cargo-clippy -Wait",
    "fmt:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/wb-heavy-run.ps1 -Task cargo-fmt -Wait"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tauri-apps/api": "^2.2.0",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
